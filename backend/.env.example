# Вставьте сюда Authorization Key из личного кабинета Sber Developers (Studio)
# Обычно это значение для заголовка Authorization: Basic <GIGACHAT_AUTH_KEY>
GIGACHAT_AUTH_KEY=PASTE_YOUR_AUTHORIZATION_KEY_HERE

# Scope получения токена: GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель: GigaChat или GigaChat-Pro
GIGACHAT_MODEL=GigaChat

# Для тестового режима можно отключить строгую проверку SSL (сертификаты Минцифры РФ):
# GIGACHAT_VERIFY_SSL=false
GIGACHAT_VERIFY_SSL=true

# При необходимости укажите путь к корневому сертификату Минцифры РФ (PEM)
# GIGACHAT_CA_BUNDLE=/path/to/russian_trusted_root_ca_pem.crt

# Настройки сервера
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://sibirproekt72.ru,https://www.sibirproekt72.ru,http://localhost:8080,http://localhost:8000

# Панель оператора: соль и SHA-256-хеш пароля (по умолчанию уже заданы в main.py).
# Если меняете пароль, пересчитайте хеш: sha256(salt + password).
# LIVE_OPERATOR_SALT=sibirproekt-live-2026
# LIVE_OPERATOR_PASSWORD_HASH=a5cc2c91f99d793b4595b67d095801e6dd557f44fd3f7a8357188c0ed8251213
